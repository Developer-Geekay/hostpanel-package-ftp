[Unit]
Description=HostPanel FTP Server (pure-ftpd)
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/opt/hostpanel/plugins/ftp/pure-ftpd \
  -l puredb:/opt/hostpanel/plugins/ftp/etc/pureftpd.pdb \
  -A \
  -E \
  -H \
  -u 1000 \
  -p 40000:40100 \
  -C 5 \
  -c 50 \
  -I 15
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
