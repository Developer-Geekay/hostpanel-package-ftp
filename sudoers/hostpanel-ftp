# HostPanel ftp plugin sudoers — installed by package manager on upload
# Removed automatically when the plugin is uninstalled.
# File operations (cp, chmod, chown, mkdir, rm) are covered by core sudoers.

# ── Virtual user management (pure-pw) ─────────────────────────────────────────
%hostpanel ALL=(root) NOPASSWD: /opt/hostpanel/plugins/ftp/pure-pw *
